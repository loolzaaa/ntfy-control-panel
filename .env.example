# ============================================================================
#  Example configuration for the ntfy control panel.
#  Copy this file to .env and edit the values.
# ============================================================================

# --- Panel web server --------------------------------------------------------
# Address and port the panel listens on
HOST=0.0.0.0
PORT=8080

# Context path under which the panel is served. Empty means the site root.
# Example: BASE_PATH=/ntfy-panel
# Use the same value when building the frontend (npm run build).
BASE_PATH=

# Environment: development | production
NODE_ENV=production

# Trust reverse proxy headers (X-Forwarded-*). Enable this if the panel
# runs behind nginx/Apache and you want the client IP detected correctly.
TRUST_PROXY=false

# --- Security ----------------------------------------------------------------
# Secret for signing the session cookie. You MUST set a random string >= 32 characters.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Administrator session lifetime, in hours
SESSION_TTL_HOURS=8

# Session cookie Secure flag: auto (default), true or false.
# "auto" sets it only when the request is secure (HTTPS, or behind a proxy with
# TRUST_PROXY=true). Use true to force it, false for plain HTTP.
COOKIE_SECURE=auto

# Session cookie name
COOKIE_NAME=ntfy_panel_sid

# Login attempt limit
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# --- Panel database (SQLite) ------------------------------------------------
# Path to the panel DB file (administrators, audit log, sessions).
# Default: <project root>/data/panel.db
# PANEL_DB=./data/panel.db

# --- Bootstrap administrator ------------------------------------------------
# Created automatically only on the first run (when the admins table is empty).
# If no password is set, one will be generated and shown in the log once.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Tokens ------------------------------------------------------------------
# Maximum number of access tokens per ntfy user (enforced by the panel)
MAX_TOKENS_PER_USER=4

# --- Authentication providers -----------------------------------------------
# Ordered list of active providers. They are tried in exactly this order.
# Supported: local (panel database), ldap. Default: local
AUTH_PROVIDERS=local

# --- LDAP provider (used when "ldap" is present in AUTH_PROVIDERS) -----------
# LDAP users always get the "user" role in the panel; administrators are local accounts.
# LDAP_URL=ldaps://ldap.example.com:636
# LDAP_BIND_DN=cn=svc,ou=services,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=ou=people,dc=example,dc=com
# LDAP_SEARCH_FILTER=(uid={{username}})
# LDAP_ATTR_USERNAME=uid
# LDAP_ATTR_DISPLAY_NAME=cn
# LDAP_ATTR_EMAIL=mail
# Use StartTLS instead of ldaps://
# LDAP_STARTTLS=false
# Verify the server certificate (disable only for self-signed certificates)
# LDAP_TLS_REJECT_UNAUTHORIZED=true
# LDAP_CONNECT_TIMEOUT_MS=5000
# Create the ntfy user automatically on first LDAP login (with a random password, no tokens)
# LDAP_PROVISION_NTFY_USER=true
# LDAP_ROLE=user

# --- ntfy CLI integration ---------------------------------------------------
# Path to the ntfy executable (or just "ntfy" if it is in PATH)
NTFY_BIN=ntfy

# Path to the ntfy user database (auth-file).
# Note: the ntfy CLI still reads /etc/ntfy/server.yml on every command, so the
# panel user must be able to read it (or point NTFY_CONFIG_FILE to a readable file).
NTFY_AUTH_FILE=/var/lib/ntfy/user.db

# Alternatively, point to the ntfy server.yml and let the CLI read auth-file
# and other parameters from it (the panel user must be able to read this file).
# NTFY_CONFIG_FILE=/etc/ntfy/server.yml

# ntfy base URL (optional; used, for example, for reset-pass)
# NTFY_BASE_URL=https://ntfy.example.com

# Timeout for ntfy CLI command execution, ms
NTFY_TIMEOUT_MS=15000
